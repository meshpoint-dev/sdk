{
  "name": "@meshpoint/sdk",
  "version": "1.2.0",
  "description": "Meshpoint client: shared agent memory for developer teams",
  "keywords": [
    "meshpoint",
    "coding-agents",
    "memory"
  ],
  "license": "MIT",
  "homepage": "https://meshpoint.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshpoint-dev/sdk.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "4.1.12"
  }
}
